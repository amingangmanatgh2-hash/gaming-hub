#!/bin/sh
# Gradle start-up script for POSIX generated by Gradle (minimal wrapper bootstrap)
# نسخه ساده‌شده: اگر gradle نصب نبود، wrapper را دانلود و اجرا می‌کند.
APP_HOME=$(cd "$(dirname "$0")/.." && pwd -P)
if command -v gradle >/dev/null 2>&1 && [ "$(gradle --version 2>/dev/null | grep -c Gradle)" -gt 0 ]; then
  exec gradle "$@"
fi
JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ ! -f "$JAR" ]; then
  echo "دانلود gradle-wrapper.jar…"
  curl -sSL -o "$JAR" "https://raw.githubusercontent.com/gradle/gradle/v8.5.0/gradle/wrapper/gradle-wrapper.jar" || true
fi
if [ -f "$JAR" ]; then
  exec java -jar "$JAR" "$@"
fi
echo "gradle یافت نشد. CI از android-actions/setup-android استفاده می‌کند." >&2
exit 1
