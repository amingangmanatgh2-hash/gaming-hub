{
  "name": "madar-connect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "مدار | Madar — فروشگاه کانفیگ TCP روی Cloudflare Workers، پنل مدیریت و اپ‌های همراه",
  "license": "MIT",
  "keywords": ["cloudflare", "workers", "durable-objects", "vless", "persian", "storefront"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "icons": "node scripts/icons.mjs",
    "dev": "npm run build && wrangler dev --ip 0.0.0.0 --port 8787",
    "dev:worker": "npm run dev",
    "dev:legacy": "node scripts/build.mjs && node scripts/dev-server.mjs",
    "test": "node --test --test-force-exit tests/*.test.js",
    "deploy": "node scripts/build.mjs && wrangler deploy",
    "deploy:pages": "node scripts/build.mjs && wrangler pages deploy public --project-name madar-connect",
    "pages:dev": "node scripts/build.mjs && wrangler pages dev public",
    "tail": "wrangler tail",
    "clean": "node -e \"require('fs').rmSync('public/build',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "wrangler": "^4.149.0",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "jsdom": "^25.0.1"
  }
}
