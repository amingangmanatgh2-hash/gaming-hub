{
  "name": "hamkalam",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "هم‌کلام | Hamkalam — اتاق گفتگوی تصویری/متنی رایگان، فوق‌سبک و بهینه برای اینترنت ایران (Cloudflare Workers/Pages + Durable Objects)",
  "license": "MIT",
  "keywords": [
    "webrtc",
    "video-call",
    "cloudflare",
    "workers",
    "durable-objects",
    "persian",
    "meeting",
    "rtl"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/dev-server.mjs",
    "dev:worker": "npm run build && wrangler dev --ip 0.0.0.0 --port 8787",
    "test": "node --test --test-force-exit tests/*.test.js",
    "deploy": "node scripts/build.mjs && wrangler deploy",
    "deploy:pages": "node scripts/build.mjs && wrangler pages deploy public --project-name hamkalam",
    "pages:dev": "node scripts/build.mjs && wrangler pages dev public",
    "tail": "wrangler tail",
    "clean": "node -e \"require('fs').rmSync('public/build',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.149.0",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "jsdom": "^25.0.1"
  }
}
